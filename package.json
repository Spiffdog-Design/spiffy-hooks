{
  "name": "@spiffdog/spiffy-hooks",
  "version": "0.0.12",
  "description": "",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spiffdog-Design/spiffy-hooks.git"
  },
  "files": [
    "/dist"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run check:fix",
      "npm run format",
      "npm run lint",
      "npm run test"
    ]
  },
  "scripts": {
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "bump-major": "npm version premajor",
    "bump-minor": "npm version preminor",
    "bump-patch": "npm version prepatch",
    "bump-release": "npm version prerelease",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^22.13.14",
    "@types/react": "^18.2.73",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^9.0.11",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "typescript": "^5.4.3",
    "vite": "^6.2.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.2.4",
    "@vitest/ui": "^3.2.4"
  },
  "peerDependencies": {
    "@uidotdev/usehooks": ">=2.4.0",
    "react": ">=18.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.14.0"
  }
}
